HOST_PORT=80
SITE_URL=https://propcount.ru
CORS_ORIGIN=https://propcount.ru,https://www.propcount.ru
CORS_ORIGINS=https://propcount.ru,https://www.propcount.ru

WEB_IMAGE=ghcr.io/koj10/arenda:latest
API_IMAGE=ghcr.io/koj10/arenda-api:latest

POSTGRES_USER=propcount
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=propcount

# С Docker API контейнер ходит в Postgres на хосте так:
DATABASE_URL=postgresql://propcount:change_me_strong_password@host.docker.internal:5432/propcount

JWT_SECRET=change_me_long_random_string
APP_ENV=production
APP_DEBUG=false
CERTBOT_EMAIL=admin@propcount.ru

# Frontend panel (build-time)
# VITE_API_URL=/__api
